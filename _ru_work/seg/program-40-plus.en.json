   "en": "<a class=\"ex\" data-video=\"https://pub-40102464ff0f4d61a636f1749e9d3111.r2.dev/t_spine_rotation.mp4\" href=\"https://elitehockeydrills.com/exercises/t-spine-rotation\" target=\"_blank\" rel=\"noopener\">T-Spine Rotation<span class=\"lk\" aria-hidden=\"true\">↗</span></a>"
  },
  {
