   "id": "h62",
   "kind": "html",
   "en": "<span class=\"sh-focus-main\">Power Integration</span><span class=\"sh-focus-sub\">Power · Posterior · Single-leg</span>"
  },
  {
   "id": "h63",
   "kind": "html",
   "en": "<span class=\"bg-name\"><span class=\"bg-num\">1</span> Joint Prep &amp; Mobility</span><span class=\"bg-mins\">10–12 min</span>"
