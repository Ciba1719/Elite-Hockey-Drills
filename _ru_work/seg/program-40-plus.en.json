   "kind": "html",
   "en": "<a class=\"ex\" data-video=\"https://pub-40102464ff0f4d61a636f1749e9d3111.r2.dev/ankle_dorsiflexion_wall.mp4\" href=\"https://elitehockeydrills.com/exercises/ankle-dorsiflexion-wall\" target=\"_blank\" rel=\"noopener\">Ankle Dorsiflexion (Wall)<span class=\"lk\" aria-hidden=\"true\">↗</span></a>"
