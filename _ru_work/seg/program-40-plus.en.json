   "en": "<a class=\"ex\" data-video=\"https://pub-40102464ff0f4d61a636f1749e9d3111.r2.dev/band_pull_apart_speed.mp4\" href=\"https://elitehockeydrills.com/exercises/band-pull-apart-speed\" target=\"_blank\" rel=\"noopener\">Band Pull-Apart Speed<span class=\"lk\" aria-hidden=\"true\">↗</span></a>"
